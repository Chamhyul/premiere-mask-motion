{
  "manifestVersion": 5,
  "id": "com.local.premiere.maskmotion",
  "name": "Mask Motion",
  "version": "0.3.2",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "maskmotion",
      "label": {
        "default": "Mask Motion"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 400,
        "height": 660
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 700
      }
    }
  ]
}
