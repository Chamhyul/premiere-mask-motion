#!/bin/sh
set -eu
fail() { echo "Mask Tracker: $*" >&2; exit 1; }
[ "${3:-/}" = / ] || fail '시동 디스크에 설치하세요.'
[ "$(/usr/bin/id -u)" -eq 0 ] || fail '관리자 권한이 필요합니다.'
uid=$(/usr/bin/stat -f %u /dev/console)
[ "$uid" -ge 500 ] || fail 'macOS 사용자 화면에 로그인한 뒤 다시 설치하세요.'
user=$(/usr/bin/id -nu "$uid")
agent='/Library/Application Support/Adobe/Adobe Desktop Common/RemoteComponents/UPI/UnifiedPluginInstallerAgent/UnifiedPluginInstallerAgent.app/Contents/MacOS/UnifiedPluginInstallerAgent'
ccx='/Library/Application Support/Mask Tracker/Installer/Mask-Tracker.ccx'
[ -x "$agent" ] && [ -f "$ccx" ] || fail 'CCX 설치에 필요한 파일이 없습니다. 다시 설치하세요.'
# UXP belongs to the logged-in Adobe user, never the Installer's root account.
if /bin/launchctl asuser "$uid" /usr/bin/sudo -H -u "$user" "$agent" --install "$ccx"; then
    echo 'Mask Tracker: CCX 설치 완료. Premiere의 컨트롤 표면에 Mask Tracker를 추가하세요.'
else
    result=$?
    fail "Adobe CCX 설치 실패 (코드 $result). Creative Cloud 로그인 상태와 권한을 확인하고 설치 파일을 다시 실행하세요."
fi
