{
  "manifestVersion": 5,
  "id": "com.local.premiere.maskmotion",
  "name": "Mask Tracker",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://api.github.com"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "maskmotion",
      "label": {
        "default": "Mask Tracker"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 400,
        "height": 660
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 700
      }
    }
  ]
}
